# Copy this file to .env and fill in what you use. NEVER commit .env (it is in .gitignore).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default provider: mock | anthropic | openai | ollama
CODEREVIEW_PROVIDER=mock
# Claude model. Check https://platform.claude.com/docs for current names and prices.
# claude-opus-5-5 is the most capable; claude-haiku-5-5 is about 40 times cheaper. Compare them on 20 alerts first.
CODEREVIEW_MODEL=claude-opus-5-5
# Claude effort: low | medium | high (more effort = more thinking = more cost)
CODEREVIEW_EFFORT=medium
# Price per million tokens. Haiku 5.5, Sonnet 5.5 and Opus 5.5 prices are built in (codereview/llm.py, PRICES);
# these two lines are only used for any other paid model.
CODEREVIEW_PRICE_IN=4
CODEREVIEW_PRICE_OUT=20
